# ─────────────────────────────────────────────────────────────────────────────
# Rubro: GENÉRICO — la base para cualquier rubro que no esté en esta carpeta.
# Se usa sola cuando RUBRO tiene un nombre sin archivo (RUBRO=ferreteria, RUBRO=libreria…):
# completá en Vercel o en .env.local las variables que quieras cambiar, o copiá este archivo
# como rubros/<tu-rubro>.env y editalo.
# Las categorías y los productos se cargan desde el panel (/admin), no desde acá.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identidad ──
MARCA_NOMBRE="Mi tienda"
MARCA_RUBRO=""
MARCA_LEMA="Lo que buscás, cerca tuyo."
MARCA_DESCRIPCION="Comprá online y recibilo en tu casa o retiralo cuando quieras."
MARCA_NOTA="tienda online"
MARCA_DESCRIPTOR=""
MARCA_LOGO="inicial"
MARCA_ILUSTRACION="logo"
MARCA_MAIL_CABECERA=""

# ── Portada ──
PORTADA_TITULO="Lo que buscás,"
PORTADA_RESALTE="cerca tuyo."
PORTADA_TEXTO="Elegí lo que necesitás, sumalo a la bolsita y mandanos el pedido. Te lo llevamos o lo retirás."
PORTADA_NOTA_DESTACADOS="lo nuevo"
PORTADA_TITULO_DESTACADOS="Destacados"

# ── Catálogo ──
CATALOGO_RUTA="productos"
CATALOGO_NOMBRE="Productos"
CATALOGO_TEXTO="Todo el catálogo, ordenado por categoría."
CATALOGO_BOTON="Ver productos"
CATALOGO_NOTA="todo el catálogo"
CATALOGO_INTRO="Filtrá por categoría y sumá a la bolsita lo que quieras."
# descargables, personalizados, packs, ideas, listas, por-mayor
SECCIONES_ABIERTAS=""
# Productos sin foto: "inicial" (la primera letra del nombre) o "dibujo" (los dibujos de papelería)
PRODUCTO_SIN_FOTO="inicial"

# ── Contacto ──
CONTACTO_WHATSAPP=""
CONTACTO_EMAIL=""
CONTACTO_INSTAGRAM=""
CONTACTO_TIKTOK=""

# ── Colores ──
COLOR_FONDO="#F7F7F5"
COLOR_FONDO_ALT="#ECEEF0"
COLOR_TEXTO="#1C2127"
COLOR_TEXTO_SUAVE="#525A64"
COLOR_LINEA="#DADDE1"
COLOR_PRINCIPAL="#24415F"
COLOR_PRINCIPAL_FUERTE="#1B3149"
COLOR_PRINCIPAL_SUAVE="#D6E0EB"
COLOR_ACENTO="#F2C14E"
COLOR_ACENTO_SUAVE="#FBEBC4"
COLOR_SECUNDARIO="#A9C4DE"
COLOR_SECUNDARIO_SUAVE="#E4EDF6"
COLOR_TERCIARIO="#8DBF9E"
COLOR_TERCIARIO_SUAVE="#DDEEE2"

# ── Tipografías (nombres exactos de Google Fonts) ──
FUENTE_TITULOS="Plus Jakarta Sans"
FUENTE_TEXTO="Inter"
FUENTE_ETIQUETAS="Inter"
FUENTE_MANO=""
# Títulos en mayúsculas: "si" o "no" (sin valor, lo decide el estilo)
TITULOS_MAYUSCULAS=""
TEXTO_ESCALA="1"

# ── Estilo ──
# El paquete de diseño: "artesanal" (bordes marcados, sombra de sello, cintas y notas a mano, como Alas de Ángel),
# "moderno" (limpio, sombras suaves, sin giros ni dibujos), "minimalista" (casi sin decoración, sin sombras)
# o "audaz" (bloques planos, bordes gruesos, sombra dura).
ESTILO_DISENO="moderno"
# Ajustes finos: sin valor, usan los del paquete.
ESTILO_RADIO_CHICO=""
ESTILO_RADIO=""
ESTILO_RADIO_GRANDE=""
ESTILO_RADIO_PASTILLA=""  # botones y etiquetas ("999px" = pastilla)
ESTILO_LINEA=""
ESTILO_SOMBRA=""  # "sello", "suave" o "ninguna"
ESTILO_SOMBRA_DESPLAZAMIENTO=""
ESTILO_PATRON=""  # patrón dibujado en la portada: "si" o "no"
ESTILO_ANCHO=""
