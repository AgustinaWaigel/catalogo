# ── Estilo ──
# El paquete de diseño: "artesanal" (bordes marcados, sombra de sello, cintas y notas a mano, como Alas de Ángel),
# "moderno" (limpio, sombras suaves, sin giros ni dibujos), "minimalista" (casi sin decoración, sin sombras)
# o "audaz" (bloques planos, bordes gruesos, sombra dura).
ESTILO_DISENO="moderno"
# Ajustes finos: sin valor, usan los del paquete.
ESTILO_RADIO_CHICO=""
ESTILO_RADIO="20px"
ESTILO_RADIO_GRANDE="32px"
ESTILO_RADIO_PASTILLA=""  # botones y etiquetas ("999px" = pastilla)
